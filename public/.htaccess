# Directories open index.php first; no directory listings in the web root.
DirectoryIndex index.php index.html
Options -Indexes

# Clean URLs: /login instead of /login.php. The app's own links are already clean (url() in app/helpers.php);
# these rules redirect old .php links and map clean paths back to the PHP files.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. /x/index.php -> /x/   (page loads only: a POST must never be redirected, the browser would drop its data)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s(/(?:[^?\s]*/)?)index\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. /page.php -> /page   (page loads only; api/ endpoints keep .php: the pages' scripts, uploads, downloads and the Paystack webhook call them)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} !\s[^?\s]*/api/ [NC]
    RewriteCond %{THE_REQUEST} \s/([^?\s]+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 3. /page -> page.php internally (the query string carries over)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Friendly error pages
ErrorDocument 403 /prepdeck/public/error.php?code=403
ErrorDocument 404 /prepdeck/public/error.php?code=404
ErrorDocument 500 /prepdeck/public/error.php?code=500

# Never serve hidden or backup files
<FilesMatch "(^\.|\.(bak|sql|log|ini|sh|md)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
    # HTTPS only: browsers ignore this header on plain http, so it is safe to keep on for local work
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    Header unset X-Powered-By
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
    # live progress streams must not be buffered by compression
    SetEnvIfNoCase Request_URI "api/jobs\.php" no-gzip dont-vary
</IfModule>
