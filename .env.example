# Copy to .env and edit. Never commit .env.
APP_ENV=development
# URL path where /public is served. With XAMPP and the folder htdocs/prepdeck this is /prepdeck/public/
APP_BASE=/prepdeck/public/
DB_HOST=127.0.0.1
DB_NAME=prepdeck
DB_USER=root
DB_PASS=
# --- AI (Claude API). Server side only ---
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Optional: a different endpoint (proxy or compatible gateway)
AI_API_URL=
# Optional: folder holding pdftotext / pdfinfo when they are not on the PATH (Windows example: C:/poppler/Library/bin).
# Without poppler the AI reads every PDF itself, which costs more credit.
POPPLER_PATH=
# Optional: PHP command-line binary used to start background AI workers (auto-detected; XAMPP: C:/xampp/php/php.exe)
PHP_CLI=
# --- Speech to text for lecture recordings (any OpenAI-compatible /audio/transcriptions endpoint) ---
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# --- Payments: Paystack ---
# Set PAY_PROVIDER=paystack and your SECRET key (sk_test_... while testing, sk_live_... when live).
# Leave empty to use manual confirmation (an admin presses "Mark as paid").
PAY_PROVIDER=
PAY_SECRET_KEY=
PAY_PUBLIC_KEY=
# Public address of the site, used for the Paystack return link. Example: https://prepdeck.yourschool.edu
# Leave empty to detect it automatically.
APP_URL=
# Secret for signed links (unsubscribe). Generate once: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Clean page URLs (/login instead of /login.php). Needs Apache mod_rewrite (public/.htaccess). Set 0 if your server cannot rewrite.
CLEAN_URLS=1
# --- Security ---
# IP address(es) of YOUR reverse proxy / load balancer, comma separated. Only then are X-Forwarded-For and
# X-Forwarded-Proto believed (for rate limits and the secure cookie). Leave empty when PHP faces the internet directly.
TRUSTED_PROXY=
# Optional: token a monitor sends (X-Health-Token header or ?token=) to see queue details in api/health.php
HEALTH_TOKEN=

# --- Email (see README > Email). Use a real mailbox on YOUR domain so SPF/DKIM/DMARC line up.
MAIL_FROM=no-reply@your-domain.com
MAIL_FROM_NAME=PrepDeck
MAIL_REPLY_TO=support@your-domain.com
# smtp (recommended) | mail (PHP mail()) | log (development: write to storage/mail.log). Empty = smtp when SMTP_HOST is set.
MAIL_TRANSPORT=
# Hostinger: smtp.hostinger.com, port 465 + ssl (or 587 + tls). User = the full mailbox address.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
# Optional: sign mail in the app when your provider does not (Hostinger signs for you once DKIM is on in hPanel)
DKIM_SELECTOR=
DKIM_DOMAIN=
# path to the private key file (relative to the project) or the PEM itself
DKIM_PRIVATE_KEY=
# In the Paystack dashboard (Settings > API Keys & Webhooks) set the webhook URL to:  <your site>/prepdeck/public/api/payments.php?a=webhook
